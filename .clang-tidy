Checks:
  - '*'
  - -llvmlibc-*
  - -readability-magic-numbers
  - -readability-identifier-length
  - -altera-unroll-loops
  - -modernize-use-trailing-return-type
  - -fuchsia-overloaded-operator
  - -misc-use-anonymous-namespace
  - -fuchsia-default-arguments-calls
  - -altera-struct-pack-align
  - -google-readability-todo
  - -abseil-string-find-startswith
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-pro-type-reinterpret-cast
  - -bugprone-assignment-in-if-condition
  - -android-cloexec-accept
  - -google-runtime-int
  - -fuchsia-default-arguments-declarations
  - -readability-function-cognitive-complexity
  - -cppcoreguidelines-macro-usage # for LOG_*() macros
  - -cppcoreguidelines-avoid-do-while # for LOG_*() macros
  - -fuchsia-statically-constructed-objects # for mutex in LOG_*() macros
  - -cppcoreguidelines-avoid-non-const-global-variables # for mutex in LOG_*() macros
  - -performance-unnecessary-value-param # wrong borrow checking
  - -abseil-string-find-str-contains
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -android-cloexec-open
  - -android-cloexec-pipe
  - -cppcoreguidelines-pro-type-vararg # to call `open()` from `fcntl.h` 
  - -hicpp-vararg # see above one
  - -boost-use-ranges # appears in `std::fill()`, but we do not use boost
  - -bugprone-easily-swappable-parameters # appears in `ThreadPool::ThreadPool(size_t nthreads, size_t mt)`
UseColor: true
